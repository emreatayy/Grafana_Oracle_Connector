{
  "title": "Oracle Layer 1 - CPU load above 25 (time series)",
  "folderUID": "oracle-alerting",
  "ruleGroup": "oracle-examples",
  "condition": "C",
  "for": "0m",
  "noDataState": "NoData",
  "execErrState": "Error",
  "isPaused": false,
  "data": [
    {
      "refId": "A",
      "datasourceUid": "<DS_UID>",
      "queryType": "",
      "model": {
        "refId": "A",
        "datasource": { "type": "emreatayy-oracle-datasource", "uid": "<DS_UID>" },
        "sql": "SELECT ts, value FROM f5_alert WHERE metric = 'cpu' AND $__timeFilter(ts)",
        "format": "time_series",
        "intervalMs": 15000,
        "maxDataPoints": 200
      },
      "relativeTimeRange": { "from": 3600, "to": 0 }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "datasource": { "type": "__expr__", "uid": "__expr__" }
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "datasource": { "type": "__expr__", "uid": "__expr__" },
        "conditions": [ { "evaluator": { "type": "gt", "params": [25] } } ]
      }
    }
  ]
}
